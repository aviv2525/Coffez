generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String?                  @map("password_hash")
  fullName                String                   @map("full_name")
  role                    UserRole                 @default(USER)
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  googleId                String?                  @unique @map("google_id")
  emailVerificationTokens EmailVerificationToken[]
  ordersAsBuyer           Order[]                  @relation("BuyerOrders")
  passwordResetTokens     PasswordResetToken[]
  pushSubscriptions       PushSubscription[]
  refreshTokens           RefreshToken[]
  reviews                 Review[]
  sellerProfile           SellerProfile?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  userId         String          @id @map("user_id")
  displayName    String          @map("display_name")
  bio            String?
  categories     String[]        @default([])
  locationText   String?         @map("location_text")
  avatarUrl      String?         @map("avatar_url")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  beans          String[]        @default([])
  drinkTypes     String[]        @default([])
  machineType    String?         @map("machine_type")
  openingHours   String?         @map("opening_hours")
  lat            Float?
  lng            Float?
  pickupDetails  String?         @map("pickup_details")
  isOnline       Boolean         @default(false) @map("is_online")
  webhookUrl     String?         @map("webhook_url")
  tipBit         String?         @map("tip_bit")
  tipPaypal      String?         @map("tip_paypal")
  status         String          @default("PENDING")
  tier           String          @default("HOME")
  city           String?         @map("city")
  phone          String?         @map("phone")
  street         String?         @map("street")
  milkOptions    String[]        @default([])
  menu           MenuItem[]
  orders         Order[]         @relation("SellerOrders")
  posIntegration PosIntegration?
  media          ProfileMedia[]
  reviews        Review[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id          String            @id @default(uuid())
  sellerId    String            @map("seller_id")
  title       String
  description String?
  price       Decimal           @db.Decimal(10, 2)
  imageUrl    String?           @map("image_url")
  isAvailable Boolean           @default(true) @map("is_available")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  category    String            @default("General")
  seller      SellerProfile     @relation(fields: [sellerId], references: [userId], onDelete: Cascade)
  mappings    MenuItemMapping[]
  orders      Order[]
}

model ProfileMedia {
  id           String           @id @default(uuid())
  sellerId     String           @map("seller_id")
  type         ProfileMediaType
  url          String
  thumbnailUrl String?          @map("thumbnail_url")
  title        String?
  caption      String?
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  seller       SellerProfile    @relation(fields: [sellerId], references: [userId], onDelete: Cascade)
}

model Order {
  id               String        @id @default(uuid())
  buyerId          String        @map("buyer_id")
  sellerId         String        @map("seller_id")
  menuItemId       String        @map("menu_item_id")
  status           OrderStatus   @default(PENDING)
  note             String?
  scheduledFor     DateTime?     @map("scheduled_for")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  estimatedMinutes Int?          @map("estimated_minutes")
  milkOption       String?       @map("milk_option")
  buyer            User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  menuItem         MenuItem      @relation(fields: [menuItemId], references: [id])
  seller           SellerProfile @relation("SellerOrders", fields: [sellerId], references: [userId], onDelete: Cascade)
  posLogs          OrderPosLog[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

model PosIntegration {
  id        String            @id @default(uuid())
  sellerId  String            @unique @map("seller_id")
  provider  String
  apiUrl    String            @map("api_url")
  apiKey    String            @map("api_key")
  isActive  Boolean           @default(true) @map("is_active")
  meta      Json?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  mappings  MenuItemMapping[]
  seller    SellerProfile     @relation(fields: [sellerId], references: [userId], onDelete: Cascade)
}

model MenuItemMapping {
  id               String         @id @default(uuid())
  posIntegrationId String         @map("pos_integration_id")
  menuItemId       String         @map("menu_item_id")
  externalId       String         @map("external_id")
  externalPrice    Decimal?       @map("external_price") @db.Decimal(10, 2)
  isEnabled        Boolean        @default(true) @map("is_enabled")
  createdAt        DateTime       @default(now()) @map("created_at")
  menuItem         MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  posIntegration   PosIntegration @relation(fields: [posIntegrationId], references: [id], onDelete: Cascade)

  @@unique([posIntegrationId, menuItemId])
}

model OrderPosLog {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  provider        String
  externalOrderId String?  @map("external_order_id")
  requestBody     Json     @map("request_body")
  responseBody    Json?    @map("response_body")
  statusCode      Int?     @map("status_code")
  success         Boolean  @default(false)
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String        @id @default(uuid())
  sellerId  String        @map("seller_id")
  buyerId   String        @map("buyer_id")
  rating    Int
  comment   String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  buyer     User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  seller    SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Cascade)

  @@unique([sellerId, buyerId])
}

enum UserRole {
  USER
  ADMIN
}

enum ProfileMediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}
